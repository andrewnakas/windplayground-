__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# large artifacts: data cache and climatology are rebuildable; keep results, figures,
# stats, and small checkpoints in git
artifacts/data/
artifacts/climatology/
artifacts/checkpoints/**/*.out
# resume state (optimizer moments): machine-local and rebuildable; the
# best.pt artifacts are what reproduce the reported results
artifacts/checkpoints/**/last.pt
.venv-dyn/
# ephemeral snapshot of the queue scripts taken by scripts/supervise.sh
artifacts/checkpoints/_running/

# never commit cloud credentials
.kaggle/
kaggle.json
*.kaggle.json
artifacts/kaggle/

# Live data is fetched fresh at every deploy and shipped only in the Pages
# artifact -- committing hourly forecasts would grow the repo without bound.
# WeatherNext stays committed: CI has no Google credentials to re-fetch it.
docs/data/aifs*_latest_*.json
docs/data/gfs*_latest_*.json
docs/data/hrrr*_latest_*.json
docs/data/ifs*_latest_*.json
docs/data/live_blend*_latest_*.json
docs/data/live_spread*_latest_*.json
